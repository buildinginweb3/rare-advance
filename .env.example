# Optional. Everything below has a safe default. No value here is a secret.
#
# OpenSea API v2. Used ONLY to fetch NFT artwork + traits for display.
# It is a low-privilege, rotatable demo key and is intentionally public.
# OpenSea ownership is never trusted for economics: ownership is always
# re-verified with a direct onchain ownerOf() read.
# The value below is a deliberately PUBLIC, low-privilege, rotatable demo key.
# It is only ever used to read public NFT artwork. It cannot move anything, and
# it is never used for ownership or for any economic figure.
VITE_OPENSEA_API_KEY=15fcdd3a9bd245378f2e92ae5ade40ca

# Optional extra public RPC. Falls back to the official documented endpoint.
VITE_RPC_URL=

# Optional first-party Rare Friends public JSON API base, proxied by the app.
# Defaults to https://rarefriends.com  (the API is first-party but sends no
# CORS headers, so the app routes it through its own same-origin proxy path).
VITE_RF_API_BASE=https://rarefriends.com
