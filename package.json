{
  "name": "rare-advance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rare Advance - the liquidity layer for the Rare Friends economy. Vibeathon MVP (all financing simulated).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
